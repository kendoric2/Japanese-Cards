          "sounds": "oh-hah-yoh go-zai-mahss",
          "en": "Good morning. (polite)"
        },
        {
          "jp": "ありがとう（ございます）。",
          "romaji": "arigatou (gozaimasu)",
          "sounds": "ah-ree-gah-toh (go-zai-mahss)",
          "en": "Thank you. (polite with ございます)"
        },
        {
          "jp": "おねがいします。",
          "romaji": "onegaishimasu",
          "sounds": "oh-neh-guy-shee-mahss",
          "en": "Please."
        },
        {
          "jp": "はい ／ いいえ",
          "romaji": "hai / iie",
          "sounds": "hai / ee-eh",
          "en": "Yes / No"
        },
        {
          "jp": "きょうは どうでしたか？",
          "romaji": "kyou wa dou deshita ka?",
          "sounds": "kyoh wah doh desh-tah kah?",
          "en": "How was your day?"
        },
        {
          "jp": "いいですね。",
          "romaji": "ii desu ne",
          "sounds": "ee dess neh",
          "en": "Nice. / Sounds good."
        },
        {
          "jp": "もういちど おねがいします。",
          "romaji": "mou ichido onegaishimasu",
          "sounds": "moh ee-chee-doh oh-neh-guy-shee-mahss",
          "en": "Please say that again."
        },
        {
          "jp": "じゃあね。",
          "romaji": "jaa ne",
          "sounds": "jah neh",
          "en": "See you. (casual)"
        },
        {
          "jp": "すみません。",
          "romaji": "sumimasen",
          "sounds": "soo-mee-mah-sen",
          "en": "Excuse me. / Sorry."
        },
        {
          "jp": "ちょっと まって ください。",
          "romaji": "chotto matte kudasai",
          "sounds": "choht-toh maht-teh koo-dah-sai",
          "en": "Please wait a moment."
        },
        {
          "jp": "どうぞ。",
          "romaji": "douzo",
          "sounds": "doh-zoh",
          "en": "Go ahead. / Here you are."
        },
        {
          "jp": "わかりません。",
          "romaji": "wakarimasen",
          "sounds": "wah-kah-ree-mah-sen",
          "en": "I don't understand. / I don't know."
        },
        {
          "jp": "よかったです。",
          "romaji": "yokatta desu",
          "sounds": "yoh-kaht-tah dess",
          "en": "It was good."
        },
        {
          "jp": "きょうの レッスンは よかったです。",
          "romaji": "kyou no ressun wa yokatta desu",
          "sounds": "kyoh noh rehs-soon wah yoh-kaht-tah dess",
          "en": "Today's lesson was good."
        },
        {
          "jp": "おいしいですね。",
          "romaji": "oishii desu ne",
          "sounds": "oh-ee-shee dess neh",
          "en": "It's delicious, isn't it?"
        },
        {
          "jp": "きいて ください。",
          "romaji": "kiite kudasai",
          "sounds": "kee-teh koo-dah-sai",
          "en": "Please listen."
        },
        {
          "jp": "わかりました。",
          "romaji": "wakarimashita",
          "sounds": "wah-kah-ree-mahsh-tah",
          "en": "I understand. / Got it."
        },
        {
          "jp": "ジムに いきました。",
          "romaji": "jimu ni ikimashita",
          "sounds": "jee-moo nee ee-kee-mahsh-tah",
          "en": "I went to the gym."
