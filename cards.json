    {
      "name": "How are you?",
      "cards": [
        {
          "jp": "げんきですか？",
          "romaji": "genki desu ka?",
          "sounds": "gehn-kee dess kah?",
          "en": "How are you?"
        },
        {
          "jp": "げんきです。",
          "romaji": "genki desu",
          "sounds": "gehn-kee dess",
          "en": "I'm good."
        },
        {
          "jp": "（ちょっと）つかれています。",
          "romaji": "(chotto) tsukarete imasu",
          "sounds": "(choht-toh) tsoo-kah-reh-teh ee-mahss",
          "en": "I'm (a little) tired."
        },
        {
          "jp": "しゅうまつは ゆっくりします。",
          "romaji": "shuumatsu wa yukkuri shimasu",
          "sounds": "shoo-mah-tsoo wah yook-koo-ree shee-mahss",
          "en": "I'll take it easy this weekend."
        }
      ]
    },
    {
      "name": "Greetings & everyday phrases",
      "cards": [
        {
          "jp": "こんにちは。",
          "romaji": "konnichiwa",
          "sounds": "kohn-nee-chee-wah",
          "en": "Hello. (daytime)"
        },
        {
          "jp": "こんばんは。",
          "romaji": "konbanwa",
          "sounds": "kohm-bahn-wah",
          "en": "Good evening."
        },
        {
          "jp": "おはよう。",
          "romaji": "ohayou",
          "sounds": "oh-hah-yoh",
          "en": "Good morning. (casual)"
        },
        {
          "jp": "おはようございます。",
